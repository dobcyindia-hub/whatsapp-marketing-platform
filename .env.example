# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/whatsapp_marketing

# Redis connection string, used by the BullMQ campaign send queue/worker
REDIS_URL=redis://localhost:6379

# Campaign worker tuning (optional — sensible defaults if unset)
RATE_LIMIT_PER_SECOND=10
WORKER_CONCURRENCY=5

# Random long string used to sign session cookies
SESSION_SECRET=change-me-to-a-random-64-char-string

# Random long string used to encrypt stored Meta access tokens at rest
ENCRYPTION_KEY=change-me-to-a-random-64-char-string

# Meta WhatsApp Cloud API (set once you connect a number in Phase 2)
META_APP_ID=
META_APP_SECRET=
